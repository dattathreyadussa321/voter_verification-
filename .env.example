# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas (server only; never prefix this with VITE_).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="boothguard"
# Creates the original demonstration booths/accounts only when the database is empty.
SEED_DEMO_DATA="true"
PORT=3000

# Optional: DNS servers for environments whose system DNS cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS="1.1.1.1,8.8.8.8"

# Optional: Frontend API URL (when frontend is deployed separately e.g. on Netlify)
# VITE_API_URL="https://your-backend.onrender.com"
